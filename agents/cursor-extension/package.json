{
  "name": "quotapot",
  "displayName": "QuotaPot",
  "description": "QuotaPot: DeepSeek balance, Cursor usage, Codex usage and the QuotaPot whale for Cursor, VS Code and Trae.",
  "version": "0.2.0",
  "publisher": "caffrey-li",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:quotapot.view"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quotapot.open",
        "title": "QuotaPot: Focus Side Bar"
      },
      {
        "command": "quotapot.openEditor",
        "title": "QuotaPot: Open in Editor"
      },
      {
        "command": "quotapot.openSettings",
        "title": "QuotaPot: Open Settings"
      },
      {
        "command": "quotapot.refresh",
        "title": "QuotaPot: Refresh"
      },
      {
        "command": "quotapot.setApiKey",
        "title": "QuotaPot: Set DeepSeek API Key"
      },
      {
        "command": "quotapot.openCursorDashboard",
        "title": "QuotaPot: Open Cursor Usage Dashboard"
      }
    ],
    "configuration": {
      "title": "QuotaPot",
      "properties": {
        "quotapot.deepseekBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API base URL."
        },
        "quotapot.cursorBaseUrl": {
          "type": "string",
          "default": "https://api2.cursor.sh",
          "description": "Cursor dashboard API base URL (unofficial)."
        },
        "quotapot.refreshSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "Auto refresh interval in seconds."
        },
        "quotapot.statusBar": {
          "type": "string",
          "enum": [
            "all",
            "balance",
            "cursor",
            "codex"
          ],
          "default": "all",
          "description": "What to show in the status bar."
        },
        "quotapot.deepseekLowBalance": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Warn when a DeepSeek balance is below this amount (0 disables)."
        },
        "quotapot.cursorWarningPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Warn when Cursor included usage reaches this percent."
        },
        "quotapot.codexWarningPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Warn when the Codex 5h or 7d window reaches this percent."
        },
        "quotapot.dailyTokenLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Warn when local Codex tokens today exceed this number (0 disables)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quotapot",
          "title": "QuotaPot",
          "icon": "media/quotapot.svg"
        }
      ]
    },
    "views": {
      "quotapot": [
        {
          "type": "webview",
          "id": "quotapot.view",
          "name": "QuotaPot",
          "contextualTitle": "QuotaPot"
        }
      ]
    }
  }
}
